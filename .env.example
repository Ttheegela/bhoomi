# Names only. Never put values in this file or anywhere in the repo.
# Local dev keys: run `bash ops/dev-secrets.sh` -> ~/.config/bhoomi/dev.env
# Vercel keys:    run `bash ops/vercel-secrets.sh production|preview` (Tarun only)

OPENROUTER_API_KEY=      # LLM calls. Your own key, credit limit $5.
ANTHROPIC_API_KEY=       # Local evals only (anthropic:<model> specs and the eval judge); not set on Vercel.
AGENT_MODEL=             # Optional. Agent model, e.g. openrouter:<model id>. Default anthropic/claude-haiku-5.5 (OpenRouter).
EARTHDATA_TOKEN=         # NASA Earthdata Login user token (GES DISC, PO.DAAC, AppEEARS downloads).
NOAA_CDO_TOKEN=          # Backup only: NOAA Climate Data Online, station cross-checks.
LANGFUSE_PUBLIC_KEY=     # Tracing (pk-lf-...).
LANGFUSE_SECRET_KEY=     # Tracing (sk-lf-...).
LANGFUSE_HOST=           # https://us.cloud.langfuse.com
UPTIMEROBOT_API_KEY=     # Tarun only: uptime monitor for the deployed app.
BHOOMI_ERA5_PACK=        # Optional. ERA5 pack base: https://…/era5/v1 or a local folder (earthtrends/data/era5.py). Unset: era5.PACK_URL, else Open-Meteo.
MCP_ALLOWED_HOSTS=       # Optional. Extra Host headers the /mcp endpoint accepts (comma-separated). bhoomi.earth and www.bhoomi.earth are always accepted.
