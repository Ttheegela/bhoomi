l,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],"source":{"id":"nasa_gmsl_v52","name":"NASA Global Mean Sea Level Trend from Integrated Multi-Mission Ocean Altimeters, Version 5.2","url":"https://sealevel.nasa.gov/","dataset_id":"doi:10.5067/GMSLM-TJ152","version":"5.2","record_url":"https://www.earthdata.nasa.gov/data/catalog/pocloud-merged-tp-j1-ostm-ost-gmsl-ascii-v52-5.2","retrieved":"2026-11-22","method":"Global mean sea level from satellite altimetry (TOPEX/Poseidon, the Jason series, Sentinel-6), about every 10 days and averaged by us into calendar months; it includes the seasonal cycle and is corrected for the slow sinking of the ocean floor since the last ice age (glacial isostatic adjustment, which adds about 0.24 mm a year), so it shows the water's own rise.","cadence":"monthly","deseasoned_upstream":false},"notes":["Satellite measurement of the whole ocean's average height; it does not include land rising or sinking at any coast.","Corrected for glacial isostatic adjustment (GIA), and the seasonal cycle is kept.","The average covers the ocean from 66° south to 66° north, as far as these satellites reach.","Each month is the mean of its values (one about every 10 days); a month with fewer than 2 is left empty.","The provider gives heights against its 1996-2016 average sea surface; only the change over time is used here.","The provider calls values after 28 March 2022 (from Sentinel-6 Michael Freilich) preliminary while its checks go on; none is flagged here.","Read from the provider's file GMSL_TPJAOS_5.2.txt at PO.DAAC (it needs a free Earthdata login), column 9.","NASA data, openly shared without restriction; cite: GSFC (2024), Global Mean Sea Level Trend from Integrated Multi-Mission Ocean Altimeters TOPEX/